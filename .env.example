# Mattermost + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…
# MATTERMOST_POSTGRES_IMAGE_TAG=postgres:16@sha256:…
# MATTERMOST_IMAGE_TAG=mattermost/mattermost-team-edition:11.10.1@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.mattermost.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#
# Generate a new BCrypt hash (replace YOUR_STRONG_PASSWORD):
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# Or using docker without installing apache2-utils:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Mattermost
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname and full URL for Mattermost. The hostname must resolve to
# this server's public IP for the Let's Encrypt TLS-ALPN challenge. REQUIRED.
MATTERMOST_HOSTNAME=mattermost.example.com
MATTERMOST_URL=https://mattermost.example.com

# REQUIRED — generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
MATTERMOST_DB_PASSWORD=change_me_before_first_start

# The admin account is created on first visit — do it before sharing the URL.

# Defaults below are set in the compose file; override only to diverge.
# MATTERMOST_DB_NAME=mattermostdb
# MATTERMOST_DB_USER=mattermostdbuser
# MATTERMOST_TIMEZONE=UTC

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# POSTGRES_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# POSTGRES_BACKUPS_PATH=/srv/mattermost-postgres/backups
# DATA_BACKUPS_PATH=/srv/mattermost-application-data/backups
# DATA_PATH=/mattermost/data
# POSTGRES_BACKUP_NAME=mattermost-postgres-backup
# DATA_BACKUP_NAME=mattermost-application-data-backup
